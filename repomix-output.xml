package com.example.supaclothes.entity;

import jakarta.persistence.*;
import java.math.BigDecimal;

import com.fasterxml.jackson.annotation.JsonBackReference;

/**
 * Linea de una venta. Copia precio e impuesto para conservar el historial si el producto cambia.
 */
@Entity
@Table(name = "sale_item")
public class SaleItem {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @ManyToOne(fetch = FetchType.LAZY, optional = false)
    @JoinColumn(name = "sale_id", nullable = false)
    @JsonBackReference
    private Sale sale;

    @ManyToOne(fetch = FetchType.LAZY, optional = false)
    @JoinColumn(name = "variant_id", nullable = false)
    private ProductVariant variant;

    @Column(name = "quantity", nullable = false) // > 0
    private int quantity;

    @Column(name = "unit_price", nullable = false, precision = 12, scale = 2) // precio al momento de la venta
    private BigDecimal unitPrice;

    @Column(name = "tax_rate", nullable = false, precision = 5, scale = 2)
    private BigDecimal taxRate;

    @Column(name = "discount_value", nullable = false, precision = 12, scale = 2, columnDefinition = "numeric(12,2) default 0")
    private BigDecimal discountValue = BigDecimal.ZERO;

    @Column(name = "tax_value", nullable = false, precision = 12, scale = 2, columnDefinition = "numeric(12,2) default 0")
    private BigDecimal taxValue = BigDecimal.ZERO;

    @Column(name = "line_total", nullable = false, precision = 12, scale = 2)
    private BigDecimal lineTotal;

    @Column(name = "sku_at_sale", length = 50)
    private String skuAtSale;

    @Column(name = "product_name_at_sale", length = 120)
    private String productNameAtSale;

    @Column(name = "size_at_sale", length = 20)
    private String sizeAtSale;

    @Column(name = "color_at_sale", length = 40)
    private String colorAtSale;

    public SaleItem() {
    }

    public Long getId() {
        return id;
    }

    public void setId(Long id) {
        this.id = id;
    }

    public Sale getSale() {
        return sale;
    }

    public void setSale(Sale sale) {
        this.sale = sale;
    }

    public ProductVariant getVariant() {
        return variant;
    }

    public void setVariant(ProductVariant variant) {
        this.variant = variant;
    }

    public int getQuantity() {
        return quantity;
    }

    public void setQuantity(int quantity) {
        this.quantity = quantity;
    }

    public BigDecimal getUnitPrice() {
        return unitPrice;
    }

    public void setUnitPrice(BigDecimal unitPrice) {
        this.unitPrice = unitPrice;
    }

    public BigDecimal getTaxRate() {
        return taxRate;
    }

    public void setTaxRate(BigDecimal taxRate) {
        this.taxRate = taxRate;
    }

    public BigDecimal getDiscountValue() {
        return discountValue == null ? BigDecimal.ZERO : discountValue;
    }

    public void setDiscountValue(BigDecimal discountValue) {
        this.discountValue = discountValue;
    }

    public BigDecimal getTaxValue() {
        return taxValue == null ? BigDecimal.ZERO : taxValue;
    }

    public void setTaxValue(BigDecimal taxValue) {
        this.taxValue = taxValue;
    }

    public BigDecimal getLineTotal() {
        return lineTotal;
    }

    public void setLineTotal(BigDecimal lineTotal) {
        this.lineTotal = lineTotal;
    }

    public String getSkuAtSale() {
        return skuAtSale;
    }

    public void setSkuAtSale(String skuAtSale) {
        this.skuAtSale = skuAtSale;
    }

    public String getProductNameAtSale() {
        return productNameAtSale;
    }

    public void setProductNameAtSale(String productNameAtSale) {
        this.productNameAtSale = productNameAtSale;
    }

    public String getSizeAtSale() {
        return sizeAtSale;
    }

    public void setSizeAtSale(String sizeAtSale) {
        this.sizeAtSale = sizeAtSale;
    }

    public String getColorAtSale() {
        return colorAtSale;
    }

    public void setColorAtSale(String colorAtSale) {
        this.colorAtSale = colorAtSale;
    }

}
