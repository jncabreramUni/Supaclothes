<file path="Supaclothes-frontend/css/estilos.css">
:root {
    color-scheme: light;
    --ink: #162235;
    --muted: #5f6b7b;
    --focus: #146c52;
    --line: #e7ebf1;
    --surface: #fff;
    --canvas: #f5f7fa;
    --navy: #101c2c;
    --green: #2e9b72;
    --green-dark: #237c5b;
    --red: #b33d4b;
    --field: #ffffff;
    --field-line: #dce2ea;
    --button-secondary: #ffffff;
    --button-secondary-hover: #f2f6f8;
    --low-text: #9a5a21;
    --low-surface: #fff3df;
    --stock-text: #287354;
    --stock-surface: #e8f5ee;
    --login-tint: #d9f0e6;
    font-family: Inter, "Segoe UI", Arial, sans-serif;
}

* { box-sizing: border-box; }
body { margin: 0; color: var(--ink); background: var(--canvas); }
button, input, select { font: inherit; }
button { cursor: pointer; }
select { min-height: 44px; padding: 8px 34px 8px 11px; color: var(--ink); background-color: var(--field); border: 1px solid var(--field-line); border-radius: 9px; }
[hidden] { display: none !important; }
:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }

.login-view { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: radial-gradient(circle at 15% 10%, var(--login-tint) 0, transparent 34%), var(--canvas); }
.login-card { width: min(100%, 420px); padding: 42px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 18px 55px #182b4212; }
.login-card.admin-login { border-top: 5px solid var(--navy); }
.login-card.admin-login .brand-mark { background: var(--navy); }
.login-card.admin-login #login-submit { background: var(--navy); }
.login-card.admin-login #login-submit:hover { background: #243a56; }
.brand-mark { display: grid; place-items: center; width: 44px; height: 44px; color: white; background: var(--green); border-radius: 14px; font-size: 1.375rem; font-weight: 800; }
.login-card h1 { margin: 7px 0; font-size: 1.875rem; }
.login-card .muted { margin: 0 0 28px; }
.login-card label, .form-grid label { display: grid; gap: 8px; margin: 0 0 16px; color: var(--ink); font-size: 0.8125rem; font-weight: 650; }
.login-card input, .form-grid input, .form-grid select, .filter-bar input[type="search"] { width: 100%; min-height: 44px; padding: 10px 12px; color: var(--ink); background: var(--field); border: 1px solid var(--field-line); border-radius: 8px; }
.login-card input:focus, .form-grid input:focus, .form-grid select:focus, .filter-bar input:focus { border-color: var(--focus); }
.eyebrow { margin: 0 0 8px; color: var(--green-dark); font-size: 0.625rem; font-weight: 800; letter-spacing: .14em; }
.muted { color: var(--muted); font-size: 0.8125rem; line-height: 1.6; }
.button { min-height: 44px; padding: 10px 16px; border: 1px solid transparent; border-radius: 9px; font-size: 0.8125rem; font-weight: 700; box-shadow: 0 2px 5px #182b420d; transition: background .15s, border-color .15s, box-shadow .15s, transform .15s; }
.button:not(:disabled):hover { transform: translateY(-1px); box-shadow: 0 5px 12px #182b4218; }
.button:active { transform: translateY(0); }
.button-primary { color: white; background: #237c5b; }
.button-primary:hover { background: #1b654a; }
.button-secondary { color: var(--ink); background: var(--button-secondary); border-color: var(--line); }
.button-secondary:hover { background: var(--button-secondary-hover); border-color: var(--focus); }
.button-full { width: 100%; margin-top: 6px; }
.form-message { min-height: 20px; margin: 12px 0 0; color: var(--red); font-size: 0.8125rem; }

.app-shell { min-height: 100vh; }
.sidebar { position: fixed; inset: 0 auto 0 0; z-index: 2; display: flex; flex-direction: column; width: 245px; padding: 24px 16px 18px; color: #d3dbe6; background: var(--navy); overflow-y: auto; }
.sidebar :focus-visible { outline-color: #8ee2bc; }
.skip-link { position: fixed; inset: 12px auto auto 12px; padding: 12px 16px; z-index: 4; color: var(--ink); background: var(--surface); transform: translateY(-200%); }
.skip-link:focus { transform: none; }
.brand { display: flex; align-items: center; gap: 11px; padding: 0 7px 34px; color: white; text-decoration: none; }
.brand .brand-mark { width: 39px; height: 39px; border-radius: 12px; }
.brand strong, .brand small { display: block; }
.brand strong { font-size: 0.875rem; }
.brand small { margin-top: 4px; color: #91a0b3; font-size: 0.6875rem; }
.nav-label { padding: 0 10px; color: #7e8ba0; font-size: 0.5625rem; font-weight: 800; letter-spacing: .15em; }
.navigation { display: grid; gap: 6px; }
.nav-link { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 6px 12px; color: #aab6c6; background: transparent; border: 0; border-radius: 8px; text-align: left; font-size: 0.8125rem; overflow-wrap: anywhere; }
.nav-link span { width: 18px; color: #8191a5; text-align: center; font-size: 1.0625rem; }
.nav-link:hover, .nav-link.active { color: white; background: #ffffff12; }
.nav-link.active span { color: #64d2a4; }
.sidebar-bottom { margin-top: auto; }
.user-badge { display: flex; align-items: center; gap: 10px; padding: 12px 8px; color: white; border-top: 1px solid #ffffff18; font-size: 0.75rem; overflow-wrap: anywhere; }
.avatar { display: grid; flex: 0 0 30px; place-items: center; width: 30px; height: 30px; color: #c4f0dc; background: #2e9b7240; border-radius: 50%; font-size: 0.625rem; font-weight: 800; }
.logout-link { width: 100%; color: #f0a3a6; }
.main-content { min-height: 100vh; margin-left: 245px; padding: 0 38px 48px; }
.topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; min-height: 98px; margin-bottom: 28px; padding: 12px 0; border-bottom: 1px solid var(--line); }
.topbar h1 { margin: 0; font-size: 1.4375rem; }
.topbar .eyebrow { margin-bottom: 5px; }
.topbar-preferences { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; max-width: 100%; margin-left: auto; }
.topbar-preferences label { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; padding: 6px 8px 6px 11px; color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-radius: 11px; font-size: 0.6875rem; font-weight: 700; }
.topbar-preferences select { flex: 1; min-width: 0; min-height: 44px; padding: 6px 24px 6px 8px; font-size: 0.6875rem; }
.session-pill { display: flex; align-items: center; gap: 8px; padding: 8px 11px; color: #567166; background: #e8f5ee; border-radius: 30px; font-size: 0.6875rem; font-weight: 700; }
.status-dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; }
.notice { margin: -12px 0 20px; padding: 12px 16px; color: #275d47; background: #e5f5ed; border: 1px solid #cce9da; border-radius: 9px; font-size: 0.8125rem; overflow-wrap: anywhere; }
.notice:empty { width: 1px; height: 1px; margin: 0; padding: 0; border: 0; position: absolute; clip-path: inset(50%); }
.notice.error { color: #862e39; background: #fff0f0; border-color: #f2d1d3; }
.welcome-panel { display: flex; align-items: center; justify-content: space-between; min-height: 190px; margin-bottom: 22px; padding: 30px 38px; color: white; background: linear-gradient(115deg, #122538, #1c4b4a); border-radius: 14px; overflow: hidden; }
.welcome-panel .eyebrow { color: #85d9b3; }
.welcome-panel h2 { margin: 0 0 10px; font-size: 1.6875rem; }
.welcome-panel p:last-child { max-width: 500px; margin: 0; color: #c5d4dc; font-size: 0.8125rem; line-height: 1.6; }
.welcome-art { color: #ffffff12; font-size: 6.25rem; font-weight: 900; letter-spacing: -.13em; transform: rotate(-8deg); }
.stat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 22px; }
.stat-card, .content-card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; min-width: 0; }
.stat-card { display: grid; gap: 6px; padding: 19px 21px; }
.stat-card span { color: #58667a; font-size: 0.75rem; font-weight: 650; }
.stat-card strong { font-size: 1.6875rem; }
.stat-card small { color: var(--muted); font-size: 0.6875rem; }
.content-card { margin-bottom: 20px; padding: 22px; }
.card-heading, .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.card-heading { margin-bottom: 17px; }
.card-heading h2, .card-heading h3, .section-heading h2 { margin: 0; }
.card-heading h2 { font-size: 1.0625rem; }
.card-heading h3 { font-size: 0.9375rem; }
.quick-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.quick-action { display: grid; justify-items: start; gap: 9px; padding: 17px; color: var(--ink); background: #fbfcfd; border: 1px solid var(--line); border-radius: 9px; text-align: left; }
.quick-action:hover { border-color: #a7d8c1; background: #f6fcf8; }
.quick-action > span { color: var(--green-dark); font-size: 1.1875rem; }
.quick-action strong { font-size: 0.75rem; }
.quick-action small { color: var(--muted); font-size: 0.6875rem; line-height: 1.5; }
.section-heading { margin: 0 0 19px; }
.section-heading h2 { margin-bottom: 7px; font-size: 1.3125rem; }
.section-heading p:last-child { margin: 0; color: var(--muted); font-size: 0.75rem; }
.form-card { padding-bottom: 24px; }
.form-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 14px; align-items: end; }
.form-grid label { margin-bottom: 14px; }
.field-wide { grid-column: 1 / -1; }
.form-actions { display: flex; justify-content: flex-end; padding-top: 3px; }
.form-grid > button, .form-grid .form-actions { align-self: end; margin-bottom: 14px; }
.form-grid .form-actions.field-wide, .sale-line-form .form-actions { margin-bottom: 0; }
.section-actions, .filter-bar, .customer-fields { margin-bottom: 16px; }
.section-actions, .filter-bar { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; }
.filter-bar > label:first-child { flex: 1 1 240px; min-width: 0; }
.filter-bar label { display: grid; gap: 6px; font-weight: 650; }
.filter-bar .check-label { display: flex; align-items: center; min-height: 44px; }
.check-label input { accent-color: var(--green-dark); }
.product-description { display: block; max-width: 32ch; white-space: normal; color: var(--muted); }
.payment-error { color: var(--red); font-weight: 700; }
.sale-line-form { grid-template-columns: 2fr 1fr auto; align-items: end; margin-bottom: 18px; }
.sale-line-form label { margin-bottom: 0; }
.table-wrap { width: 100%; overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
th { padding: 11px 12px; color: #657285; background: #f8fafb; font-size: 0.625rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
td { padding: 13px 12px; border-bottom: 1px solid #edf0f4; color: #364256; font-size: 0.75rem; }
tbody tr:not(:last-child) td { border-bottom-color: var(--line); }
tbody tr:hover { background: #f3faf6; }
tbody tr:last-child td { border-bottom: 0; }
.empty-cell { padding: 24px 12px; color: var(--muted); text-align: center; }
.state { display: inline-flex; padding: 5px 8px; border-radius: 20px; font-size: 0.625rem; font-weight: 700; }
.state-active, .state-stock { color: var(--stock-text); background: var(--stock-surface); }
.state-inactive, .state-low { color: var(--low-text); background: var(--low-surface); }
.table-action { min-height: 44px; margin: 2px; padding: 7px 10px; color: var(--green-dark); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; font-size: 0.6875rem; font-weight: 700; transition: background .15s, border-color .15s, transform .15s; }
.table-action:hover { background: #eff8f3; border-color: #b8ddca; transform: translateY(-1px); }
.table-action-danger { color: var(--red); background: #fffafa; border-color: #f0dadd; }
.table-action-danger:hover { background: #fff0f0; border-color: #e8bec2; }
.sale-submit { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 18px; }
.sale-submit .muted { margin: 0; }
.sale-result { margin: 12px 0 0; color: var(--green-dark); font-size: 0.8125rem; font-weight: 700; }
.sale-result:empty { display: none; }
button:disabled { cursor: not-allowed; opacity: .52; }
.user-badge { flex-wrap: wrap; }
#current-role { flex-basis: calc(100% - 42px); margin-left: 40px; color: #91a0b3; font-size: 0.625rem; }
.variant-rows { display: grid; gap: 10px; }
.variant-input-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 14px; padding: 12px; border: 1px solid var(--line); border-radius: 9px; }
.payment-fields { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
dialog { width: min(720px, calc(100% - 28px)); max-height: 90vh; padding: 22px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 24px 80px #182b4233; overflow-wrap: anywhere; }
dialog::backdrop { background: #101c2c80; }
.dialog-card { align-items: end; }
.dialog-card h2 { margin: 0 0 8px; font-size: 1.1875rem; }
.receipt-paper { max-width: 700px; margin: 0 auto 18px; padding: 16px; }
.receipt-paper table { white-space: normal; }
.receipt-paper td { vertical-align: top; }

@media (max-width: 900px) {
    .sidebar { width: 205px; }
    .main-content { margin-left: 205px; padding-right: 24px; padding-left: 24px; }
    .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sale-line-form { grid-template-columns: 1fr 1fr; }
    .sale-line-form .form-actions { grid-column: 1 / -1; }
    .variant-input-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .topbar-preferences { order: 2; width: 100%; margin: 0; }
}
@media (max-width: 650px) {
    .sidebar { position: static; width: auto; padding: 14px; }
    .brand { padding-bottom: 14px; }
    .nav-label, .sidebar-bottom { display: none; }
    .nav-link { justify-content: center; min-height: 44px; padding: 5px; text-align: center; }
    .nav-link span { font-size: 1.125rem; }
    .main-content { margin-left: 0; padding: 0 15px 30px; }
    .topbar { min-height: 78px; margin-bottom: 18px; }
    .topbar h1 { font-size: 1.25rem; }
    .session-pill { padding: 7px; }
    .welcome-panel { min-height: 170px; padding: 22px; }
    .welcome-panel h2 { font-size: 1.375rem; }
    .welcome-art { font-size: 3.75rem; }
    .stat-grid { gap: 8px; }
    .stat-card { padding: 13px 10px; }
    .stat-card span { font-size: 0.625rem; }
    .stat-card strong { font-size: 1.375rem; }
    .stat-card small { font-size: 0.5625rem; }
    .quick-actions { grid-template-columns: 1fr; }
    .content-card { padding: 16px; }
    .section-heading { align-items: flex-start; }
    .section-heading .button { padding: 8px; font-size: 0.6875rem; }
}
@media (max-width: 430px) {
    .form-grid, .sale-line-form { grid-template-columns: 1fr; }
    .variant-input-row { grid-template-columns: 1fr; }
    .field-wide, .sale-line-form .form-actions { grid-column: auto; }
    .form-actions { justify-content: stretch; }
    .form-actions .button { width: 100%; }
    .login-card { padding: 30px 24px; }
}

[data-theme="dark"] {
    color-scheme: dark;
    --ink: #edf2f8;
    --muted: #b2c0d0;
    --focus: #8ee2bc;
    --line: #405063;
    --surface: #223144;
    --canvas: #152131;
    --green-dark: #8ee2bc;
    --red: #ffb6bd;
    --field: #172536;
    --field-line: #405063;
    --button-secondary: #172536;
    --button-secondary-hover: #263d4a;
    --low-text: #fff3df;
    --low-surface: #524233;
    --stock-text: #8ee2bc;
    --stock-surface: #1d3440;
    --login-tint: #223144;
}
[data-text="large"] { font-size: 120%; }
[data-text="extra-large"] { font-size: 140%; }

/* Resultados, reportes y devoluciones. */
.analytics-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.analytics-stats strong { font-size: clamp(1.125rem, 2.2vw, 1.6875rem); overflow-wrap: anywhere; }
.sales-chart { margin: 24px 0; }
.sales-chart figcaption { font-weight: 700; }
.chart-legend { display: flex; flex-wrap: wrap; gap: 20px; font-size: 0.75rem; }
.chart-legend span::before { content: ""; display: inline-block; width: 12px; height: 12px; margin-right: 6px; border-radius: 2px; }
.legend-sales::before, .chart-sales { background: #2e9b72; }
.legend-refunds::before, .chart-refunds { background: #c56c37; }
.chart-scroll { overflow-x: auto; padding-top: 12px; }
.chart-bars { min-width: 100%; width: max-content; display: flex; gap: 16px; align-items: end; }
.chart-day { flex: 1 0 42px; text-align: center; font-size: 0.6875rem; }
.chart-tracks { height: 170px; border-bottom: 1px solid var(--muted); display: flex; justify-content: center; align-items: end; gap: 3px; }
.chart-bar { width: 16px; border-radius: 3px 3px 0 0; }
.chart-day > span { display: block; margin-top: 9px; }
#dashboard-message, #report-message, #report-summary, #return-status { font-size: 0.8125rem; line-height: 1.6; overflow-wrap: anywhere; }
#report-caption { padding: 12px 0; color: var(--muted); text-align: left; font-size: 0.8125rem; }
.return-panel { padding: 16px 0; margin-bottom: 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.return-panel h3 { margin-top: 0; }
.button-danger { color: white; background: #a33845; }
.button-danger:hover { background: #862b36; }
.form-actions { flex-wrap: wrap; gap: 8px; }
summary { cursor: pointer; padding: 10px 0; }
[data-theme="dark"] th { color: var(--muted); background: #172536; }
[data-theme="dark"] td { color: var(--ink); border-color: var(--line); }
[data-theme="dark"] tbody tr:hover { background: #1d3440; }
[data-theme="dark"] .table-action { color: #8ee2bc; background: #172536; border-color: var(--line); }
[data-theme="dark"] .table-action:hover { background: #263d4a; border-color: #49765f; }
[data-theme="dark"] .table-action-danger { color: #ffb6bd; border-color: #69444c; }
[data-theme="dark"] .table-action-danger:hover { background: #422d37; border-color: #8d5360; }
@media (max-width: 650px) {
    .navigation { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .navigation .nav-link { font-size: 0.6875rem; flex-direction: column; gap: 3px; }
    .analytics-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .topbar { flex-wrap: wrap; gap: 10px; padding: 14px 0; }
    .topbar-preferences { order: 2; width: 100%; margin: 0; }
    .topbar-preferences label { display: grid; flex: 1; gap: 4px; padding: 6px; font-size: 0.6875rem; }
    .topbar-preferences select { width: 100%; padding-right: 6px; }
    .session-pill { order: 1; margin-left: auto; }
}

[data-theme="dark"] .stat-card span { color: var(--muted); }
[data-theme="dark"] .quick-action { background: var(--canvas); }
[data-theme="dark"] .quick-action:hover { background: #2a4054; }
[data-theme="dark"] .button-primary:hover { background: #1b654a; }
[data-theme="dark"] .notice { color: var(--stock-text); background: var(--stock-surface); border-color: var(--line); }
[data-theme="dark"] .notice.error { color: var(--red); background: #422d37; border-color: #69444c; }

@media (prefers-reduced-motion: reduce) {
    .button, .table-action { transition: none; }
    .button:hover, .table-action:hover { transform: none; }
}
</file>

