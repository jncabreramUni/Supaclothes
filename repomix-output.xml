<file path="mobile-app/src/auth/session.tsx">
import * as SecureStore from 'expo-secure-store';
import { createContext, useCallback, useContext, useEffect, useRef, useState, type ReactNode } from 'react';
import { ApiError, apiUrl, request, type ApiRequest, type RequestOptions } from '../api/client';
import { logIn } from '../api/operations';
import type { AuthLoginRequest, AuthResponse, Role } from '../types/api';

type Session = AuthResponse & { username: string; origin: string };
const sessionKey = 'supaclothes.session';
const roles: Role[] = ['ADMIN', 'VENDEDOR', 'BODEGA'];

interface SessionContextValue {
  session: Session | null;
  loading: boolean;
  api: ApiRequest;
  signIn: (credentials: AuthLoginRequest, admin: boolean) => Promise<void>;
  signOut: () => Promise<void>;
}

const SessionContext = createContext<SessionContextValue | null>(null);

export function SessionProvider({ children }: { children: ReactNode }) {
  const [session, setSession] = useState<Session | null>(null);
  const [loading, setLoading] = useState(true);
  const current = useRef<Session | null>(null);
  const storageWrites = useRef(Promise.resolve());

  const writeSession = useCallback((next: Session | null) => {
    const write = storageWrites.current.catch(() => undefined).then(() => next
      ? SecureStore.setItemAsync(sessionKey, JSON.stringify(next))
      : SecureStore.deleteItemAsync(sessionKey));
    storageWrites.current = write;
    return write;
  }, []);

  useEffect(() => {
    let active = true;
    async function restore() {
      try {
        const stored = await SecureStore.getItemAsync(sessionKey);
        if (!stored || !active) return;
        const saved: Session = JSON.parse(stored);
        if (saved.origin !== apiUrl || !roles.includes(saved.role) || !saved.token || !saved.username) return;
        current.current = saved;
        setSession(saved);
      } catch {
        // The login screen remains available if local storage cannot be read.
      } finally {
        if (active) setLoading(false);
      }
    }
    void restore();
    return () => { active = false; };
  }, []);

  const invalidate = useCallback((expected: Session) => {
    if (current.current !== expected) return Promise.resolve();
    current.current = null;
    setSession(null);
    return writeSession(null);
  }, [writeSession]);

  const api: ApiRequest = useCallback(async <T,>(path: string, options?: RequestOptions) => {
    const signedIn = current.current;
    if (!signedIn) throw new ApiError(401, 'Inicia sesión para continuar.');
    try {
      return await request<T>(path, options, signedIn.token);
    } catch (error) {
      if (!(error instanceof ApiError) || error.status !== 401) throw error;
      if (path !== '/products') {
        // Spring can return 401 from its error dispatch even while the JWT is valid.
        try {
          await request('/products', { signal: options?.signal }, signedIn.token);
        } catch (verificationError) {
          if (verificationError instanceof ApiError && verificationError.status === 401) {
            await invalidate(signedIn).catch(() => undefined);
          }
          throw verificationError;
        }
        throw new ApiError(403, 'SupaClothes rechazó la operación. Revisa los datos o los permisos de tu cuenta.');
      }
      await invalidate(signedIn).catch(() => undefined);
      throw error;
    }
  }, [invalidate]);

  async function signIn(credentials: AuthLoginRequest, admin: boolean) {
    const result = await logIn(credentials, admin);
    if (!roles.includes(result.role) || !result.token) {
      throw new Error('La API no devolvió una sesión válida para SupaClothes.');
    }
    const next = { ...result, username: credentials.username, origin: apiUrl };
    await writeSession(next);
    current.current = next;
    setSession(next);
  }

  async function signOut() {
    const signedIn = current.current;
    if (!signedIn) return;
    try {
      await request<void>('/auth/logout', { method: 'POST' }, signedIn.token);
    } catch (error) {
      if (!(error instanceof ApiError && error.status === 401)) throw error;
    }
    await invalidate(signedIn);
  }

  return (
    <SessionContext.Provider value={{ session, loading, api, signIn, signOut }}>
      {children}
    </SessionContext.Provider>
  );
}

export function useSession() {
  const value = useContext(SessionContext);
  if (!value) throw new Error('SessionProvider es obligatorio.');
  return value;
}
</file>

<file path="mobile-app/src/components/attachments.ts">
import { randomUUID } from 'expo-crypto';
import { Directory, File, Paths } from 'expo-file-system';
import { EncodingType, StorageAccessFramework } from 'expo-file-system/legacy';
import * as Sharing from 'expo-sharing';
import { Platform } from 'react-native';

export const pdfMime = 'application/pdf';

export function attachmentFile(name: string) {
  const folder = new Directory(Paths.cache, 'supaclothes', randomUUID());
  folder.create({ intermediates: true });
  return new File(folder, name.replace(/[^a-z0-9._-]/gi, '-'));
}

export async function shareAttachment(file: File, mimeType: string) {
  if (!await Sharing.isAvailableAsync()) throw new Error('Este dispositivo no puede compartir archivos.');
  await Sharing.shareAsync(file.uri, {
    mimeType,
    UTI: mimeType === pdfMime ? 'com.adobe.pdf' : 'org.openxmlformats.spreadsheetml.sheet',
  });
}

export async function saveAttachment(file: File, mimeType: string) {
  if (Platform.OS !== 'android') {
    await shareAttachment(file, mimeType);
    return false;
  }

  const access = await StorageAccessFramework.requestDirectoryPermissionsAsync();
  if (!access.granted) return false;
  const content = await file.base64();
  const destination = await StorageAccessFramework.createFileAsync(access.directoryUri, file.name.replace(/\.[^.]+$/, ''), mimeType);
  await StorageAccessFramework.writeAsStringAsync(destination, content, { encoding: EncodingType.Base64 });
  return true;
}
</file>

<file path="mobile-app/src/components/catalog-editor.tsx">
import { useRef, useState } from 'react';
import { StyleSheet, View } from 'react-native';
import type { ApiRequest } from '../api/client';
import { createProduct, createVariant, updateProduct, updateVariant } from '../api/operations';
import type { Product, ProductVariantRequest } from '../types/api';
import { radius, useTheme } from '../theme';
import { Button, Copy, Field, FormModal, Notice } from './ui';
import { useAction } from './use-action';

export type CatalogEdit =
  | { kind: 'new-product' }
  | { kind: 'product'; product: Product }
  | { kind: 'variant'; product: Product; variantId?: number };

type VariantDraft = Record<keyof ProductVariantRequest, string>;

function variantDraft(variant?: ProductVariantRequest): VariantDraft {
  return {
    sku: variant?.sku ?? '',
    size: variant?.size ?? '',
    color: variant?.color ?? '',
    price: variant ? String(variant.price) : '',
    taxRate: String(variant?.taxRate ?? 0.19),
    minStock: String(variant?.minStock ?? 0),
  };
}

function decimal(text: string, integerDigits: number) {
  const normalized = text.trim().replace(',', '.');
  return new RegExp(`^\\d{1,${integerDigits}}(?:\\.\\d{1,2})?$`).test(normalized) ? Number(normalized) : null;
}

function parseVariant(draft: VariantDraft, label: string): ProductVariantRequest {
  const sku = draft.sku.trim();
  const size = draft.size.trim();
  const color = draft.color.trim();
  if (!sku || !size || !color) throw new Error(`${label}. Ingresa el SKU, la talla y el color.`);
  const price = decimal(draft.price, 10);
  const taxRate = decimal(draft.taxRate, 3);
  if (price === null || taxRate === null) {
    throw new Error(`${label}. Ingresa un precio y una tasa de IVA válidos, con hasta dos decimales.`);
  }
  const minStock = Number(draft.minStock.trim());
  if (!/^\d+$/.test(draft.minStock.trim()) || minStock > 2147483647) {
    throw new Error(`${label}. El stock mínimo debe ser un entero entre 0 y 2.147.483.647.`);
  }
  return { sku, size, color, price, taxRate, minStock };
}

export function CatalogEditor({ edit, api, onSaved, onClose }: {
  edit: CatalogEdit; api: ApiRequest; onSaved: (product: Product, message: string) => void; onClose: () => void;
}) {
  const action = useAction();
  const { colors } = useTheme();
  const product = edit.kind === 'new-product' ? undefined : edit.product;
  const existingVariant = edit.kind === 'variant' ? edit.product.variants.find(variant => variant.id === edit.variantId) : undefined;
  const [name, setName] = useState(product?.name ?? '');
  const [category, setCategory] = useState(product?.category ?? '');
  const [description, setDescription] = useState(product?.description ?? '');
  const [rows, setRows] = useState(() => [{ key: 0, fields: variantDraft(existingVariant) }]);
  const nextKey = useRef(1);
  const title = edit.kind === 'new-product' ? 'Nuevo producto' : edit.kind === 'product'
    ? 'Editar producto' : existingVariant ? `Editar variante ${existingVariant.sku}` : `Agregar variante a ${edit.product.name}`;

  function save() {
    void action.run(async () => {
      if (edit.kind === 'variant') {
        const body = parseVariant(rows[0].fields, 'Variante');
        const saved = edit.variantId === undefined
          ? await createVariant(api, edit.product.id, body)
          : await updateVariant(api, edit.product.id, edit.variantId, body);
        onSaved(saved, `Variante ${body.sku} guardada.`);
        return;
      }

      const fields = { name: name.trim(), category: category.trim(), description: description.trim() || null };
      if (!fields.name || !fields.category) throw new Error('Ingresa el nombre y la categoría.');
      if (edit.kind === 'product') {
        onSaved(await updateProduct(api, edit.product.id, fields), 'Producto actualizado.');
        return;
      }

      const variants = rows.map(({ fields: draft }, index) => parseVariant(draft, `Variante ${index + 1}`));
      if (new Set(variants.map(variant => variant.sku)).size !== variants.length) {
        throw new Error('Cada variante debe tener un SKU distinto.');
      }
      onSaved(await createProduct(api, { ...fields, variants }), 'Producto creado.');
    });
  }

  return (
    <FormModal title={title} busy={action.busy} onClose={onClose}>
      {edit.kind !== 'variant' && (
        <>
          <Field label="Nombre" autoCapitalize="sentences" value={name} onChangeText={setName} maxLength={120} editable={!action.busy} />
          <Field label="Categoría" value={category} onChangeText={setCategory} maxLength={80} editable={!action.busy} />
          <Field label="Descripción (opcional)" value={description} onChangeText={setDescription} maxLength={255}
            multiline editable={!action.busy} />
        </>
      )}
      {edit.kind !== 'product' && rows.map(({ key, fields }, index) => (
        <View key={key} style={[styles.variant, { borderColor: colors.line }]}>
          {edit.kind === 'new-product' && <Copy strong>Variante {index + 1}</Copy>}
          <VariantFields draft={fields} disabled={action.busy} onChange={(field, value) =>
            setRows(current => current.map(row => row.key === key
              ? { key, fields: { ...row.fields, [field]: value } } : row))} />
          {rows.length > 1 && <Button label={`Quitar variante ${index + 1}`} kind="secondary" disabled={action.busy}
            onPress={() => setRows(current => current.filter(row => row.key !== key))} />}
        </View>
      ))}
      {edit.kind === 'new-product' && <Button label="Añadir otra variante" kind="secondary" disabled={action.busy} onPress={() => {
        const key = nextKey.current++;
        setRows(current => [...current, { key, fields: variantDraft() }]);
      }} />}
      {action.error !== '' && <Notice message={action.error} error />}
      <Button label={edit.kind === 'new-product' ? 'Crear producto' : 'Guardar cambios'} busy={action.busy} onPress={save} />
    </FormModal>
  );
}

function VariantFields({ draft, disabled, onChange }: {
  draft: VariantDraft; disabled: boolean; onChange: (field: keyof VariantDraft, value: string) => void;
}) {
  return (
    <>
      <Field label="SKU" value={draft.sku} maxLength={50} autoCapitalize="none" autoCorrect={false}
        onChangeText={value => onChange('sku', value)} editable={!disabled} />
      <Field label="Talla" value={draft.size} maxLength={20} onChangeText={value => onChange('size', value)} editable={!disabled} />
      <Field label="Color" value={draft.color} maxLength={40} onChangeText={value => onChange('color', value)} editable={!disabled} />
      <Field label="Precio (COP)" keyboardType="decimal-pad" value={draft.price}
        onChangeText={value => onChange('price', value)} editable={!disabled} />
      <Field label="Tasa de IVA (0,19 equivale a 19 %)" keyboardType="decimal-pad" value={draft.taxRate}
        onChangeText={value => onChange('taxRate', value)} editable={!disabled} />
      <Field label="Stock mínimo" keyboardType="number-pad" value={draft.minStock}
        onChangeText={value => onChange('minStock', value)} editable={!disabled} />
    </>
  );
}

const styles = StyleSheet.create({ variant: { padding: 12, gap: 10, borderWidth: 1, borderRadius: radius.field } });
</file>

<file path="mobile-app/src/components/customer-lookup.tsx">
import { useCallback, useState } from 'react';
import { createCustomer, lookupCustomers } from '../api/operations';
import { useSession } from '../auth/session';
import type { Customer } from '../types/api';
import { Button, Card, Copy, Field, FormModal, ListRow, Loading, Notice } from './ui';
import { useAction } from './use-action';
import { useResource } from './use-resource';

export function CustomerLookup({ onSelect, selectedId }: {
  onSelect?: (customer: Customer | null) => void;
  selectedId?: number | null;
}) {
  const { api } = useSession();
  const [input, setInput] = useState('');
  const [query, setQuery] = useState<string | null>(null);
  const [showForm, setShowForm] = useState(false);
  const [message, setMessage] = useState('');
  const customers = useResource(useCallback((signal: AbortSignal) =>
    query === null ? Promise.resolve([]) : lookupCustomers(api, query, signal), [api, query]));

  function search() {
    const next = input.trim();
    if (query === next) customers.reload();
    else setQuery(next);
  }

  return (
    <Card title="Buscar clientes">
      <Field label="Nombre o número de documento" value={input} onChangeText={setInput}
        returnKeyType="search" onSubmitEditing={search} />
      <Button label="Buscar" kind="secondary" onPress={search} />
      <Button label="Registrar cliente" onPress={() => setShowForm(true)} />
      {message !== '' && <Notice message={message} />}
      {onSelect && (
        <ListRow selected={selectedId === null} onPress={() => onSelect(null)}>
          <Copy strong>Consumidor final</Copy>
        </ListRow>
      )}
      {query !== null && customers.loading && <Loading />}
      {customers.error !== '' && <Notice message={customers.error} error />}
      {query !== null && !customers.loading && customers.error === '' && customers.data?.length === 0
        && <Copy tone="muted">No hay clientes para esta búsqueda.</Copy>}
      {query !== null && !customers.loading && customers.error === '' && customers.data?.map(customer => (
        <ListRow key={customer.id} selected={customer.id === selectedId}
          onPress={onSelect ? () => onSelect(customer) : undefined}>
          <Copy strong>{customer.name}</Copy>
          <Copy tone="muted">{[customer.documentType, customer.documentNumber].filter(Boolean).join(' ')}</Copy>
          {!onSelect && customer.phone ? <Copy tone="muted">{customer.phone}</Copy> : null}
          {!onSelect && customer.email ? <Copy tone="muted">{customer.email}</Copy> : null}
        </ListRow>
      ))}
      {showForm && <CustomerForm onClose={() => setShowForm(false)} onCreated={customer => {
        setShowForm(false);
        if (onSelect) {
          onSelect(customer);
          return;
        }
        setMessage(`Cliente ${customer.name} registrado.`);
        setInput(customer.documentNumber);
        if (query === customer.documentNumber) customers.reload();
        else setQuery(customer.documentNumber);
      }} />}
    </Card>
  );
}

const documentTypes = ['CC', 'CE', 'NIT', 'PASAPORTE', 'OTRO'];

function CustomerForm({ onClose, onCreated }: {
  onClose: () => void; onCreated: (customer: Customer) => void;
}) {
  const { api } = useSession();
  const action = useAction();
  const [documentType, setDocumentType] = useState('CC');
  const [documentNumber, setDocumentNumber] = useState('');
  const [name, setName] = useState('');
  const [phone, setPhone] = useState('');
  const [email, setEmail] = useState('');

  function submit() {
    void action.run(async () => {
      if (!name.trim() || !documentNumber.trim()) throw new Error('Ingresa el número de documento y el nombre.');
      if (phone.trim() && !/^\+?[0-9 ()-]{7,20}$/.test(phone.trim())) throw new Error('Revisa el formato del teléfono.');
      if (email.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) throw new Error('Revisa el formato del correo.');
      onCreated(await createCustomer(api, { documentType, documentNumber: documentNumber.trim(), name: name.trim(),
        phone: phone.trim() || null, email: email.trim() || null }));
    });
  }

  return (
    <FormModal title="Registrar cliente" busy={action.busy} onClose={onClose}>
      <Copy strong>Tipo de documento</Copy>
      {documentTypes.map(type => (
        <ListRow key={type} selected={type === documentType} onPress={action.busy ? undefined : () => setDocumentType(type)}>
          <Copy strong={type === documentType}>{type}</Copy>
        </ListRow>
      ))}
      <Field label="Número de documento" value={documentNumber} onChangeText={setDocumentNumber}
        maxLength={30} autoCapitalize="characters" editable={!action.busy} />
      <Field label="Nombre completo" value={name} onChangeText={setName} maxLength={120}
        autoCapitalize="words" editable={!action.busy} />
      <Field label="Teléfono (opcional)" value={phone} onChangeText={setPhone} maxLength={20}
        keyboardType="phone-pad" autoComplete="tel" editable={!action.busy} />
      <Field label="Correo (opcional)" value={email} onChangeText={setEmail} maxLength={120}
        autoCapitalize="none" autoComplete="email" keyboardType="email-address" editable={!action.busy} />
      {action.error !== '' && <Notice message={action.error} error />}
      <Button label="Guardar cliente" busy={action.busy} onPress={submit} />
    </FormModal>
  );
}
